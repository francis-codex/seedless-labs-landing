{
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/claim",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/c",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/c",
      "destination": "/claim"
    },
    {
      "source": "/x/:path*",
      "destination": "https://seedless-api.francislogo2219.workers.dev/x/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/download/seeker",
      "destination": "https://github.com/seedless-labs/seedless-labs-landing/releases/download/clockin-1.0.4/seedless-1.0.4-seeker.apk",
      "permanent": false
    },
    {
      "source": "/downloads/seeker",
      "destination": "https://github.com/seedless-labs/seedless-labs-landing/releases/download/clockin-1.0.4/seedless-1.0.4-seeker.apk",
      "permanent": false
    },
    {
      "source": "/darkpaper",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/index-old",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v5",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/og-source",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/developers",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/fees",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/beta",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/waitlist",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/download",
      "permanent": true
    }
  ]
}
